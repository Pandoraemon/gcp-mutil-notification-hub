{#
  降级模板：类型没有专用模板时使用（必须存在，否则降级路径本身会抛 TemplateNotFound）。
  转义规则：所有插值都用 | tojson，且 | tojson 自带外层引号，模板里不要再包 "。
#}
{
  "config": {
    "wide_screen_mode": true
  },
  "header": {
    "title": {
      "tag": "plain_text",
      "content": {{ (severity_icon ~ " [GCP 告警] " ~ title) | tojson }}
    },
    "template": {{ severity_color | tojson }}
  },
  "elements": [
    {
      "tag": "div",
      "text": {
        "tag": "lark_md",
        "content": {{ ("**严重性**: " ~ severity) | tojson }}
      }
    },
    {%- for key, value in fields.items() %}
    {
      "tag": "div",
      "text": {
        "tag": "plain_text",
        "content": {{ (key ~ ": " ~ value) | tojson }}
      }
    },
    {%- endfor %}
    {
      "tag": "div",
      "text": { "tag": "plain_text", "content": {{ ("🕐 " ~ timestamp) | tojson }} }
    }
    {%- if console_url %},
    {
      "tag": "action",
      "actions": [
        {
          "tag": "button",
          "text": { "tag": "plain_text", "content": "查看详情" },
          "url": {{ console_url | tojson }},
          "type": "primary"
        }
      ]
    }
    {%- endif %}
  ]
}
