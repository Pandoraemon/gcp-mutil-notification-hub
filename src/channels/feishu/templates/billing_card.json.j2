{# Cloud Billing 预算告警卡片：默认路由到财务群（未配置时回落默认群）。 #}
{
  "config": {
    "wide_screen_mode": true
  },
  "header": {
    "title": {
      "tag": "plain_text",
      "content": {{ (severity_icon ~ " [Billing] " ~ title) | tojson }}
    },
    "template": {{ severity_color | tojson }}
  },
  "elements": [
    {
      "tag": "div",
      "text": {
        "tag": "lark_md",
        "content": {{ ("**严重性**: " ~ severity) | tojson }}
      }
    },
    {%- for key, value in fields.items() %}
    {
      "tag": "div",
      "text": {
        "tag": "plain_text",
        "content": {{ (key ~ ": " ~ value) | tojson }}
      }
    },
    {%- endfor %}
    {
      "tag": "div",
      "text": { "tag": "plain_text", "content": {{ ("🕐 " ~ timestamp) | tojson }} }
    }
    {%- if console_url %},
    {
      "tag": "action",
      "actions": [
        {
          "tag": "button",
          "text": { "tag": "plain_text", "content": "查看预算" },
          "url": {{ console_url | tojson }},
          "type": "primary"
        }
      ]
    }
    {%- endif %}
  ]
}
